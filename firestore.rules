rules_version = '2';

// Paste into: Firebase Console -> Firestore Database -> Rules -> Publish.
//
// Anyone signed in can read and write. Since account creation is disabled in
// the console, "signed in" means an account you made yourself - so this is
// effectively you only. Nothing is readable without logging in.

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

